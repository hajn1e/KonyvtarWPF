<Window x:Class="KonyvtarWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KonyvtarWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="250"/>
                 </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Könyv címe"
                           VerticalAlignment="Center"/> 
                <TextBox x:Name="TitleTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="30"
                         VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="0"
                            Grid.Column="3"
                            Text="Szerző"
                            VerticalAlignment="Center"/>
                <TextBox x:Name="AuthorTextBox"
                         Grid.Row="0"
                         Grid.Column="4"
                         Height="30"
                         VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Kiadási év:"
                           VerticalAlignment="Center"/>   
                <TextBox x:Name="PublicationYearTextBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Height="30"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="Ár:"
                           VerticalAlignment="Center"/>   
                <TextBox x:Name="PriceTextBox"
                          Grid.Row="1"
                          Grid.Column="4"
                          Height="30"
                  VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Készlet:"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="StockTextBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="30"
                          VerticalAlignment="Center"/>
                
                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            >
                    <Button x:Name="AddBookButton"
                            Content="Hozzáadás"
                            Width="120"
                            Height="35"
                            Margin="5"/>
                    <Button x:Name="UpdateBookButton"
                            Content="Módosítás"
                            Width="120"
                            Height="35"
                            Margin="5"/>
                    <Button x:Name="DeleteBookButton"
                            Content="Törlés"
                            Width="120"
                            Height="35"
                            Margin="5"/>
                    <Button x:Name="ClearFieldsButton"
                            Content="Mezők törlése"
                            Width="120"
                            Height="35"
                            Margin="5"/>
                    <Button x:Name="UpdateButton"
                            Content="Frissítés"
                            Width="120"
                            Height="35"
                            Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0"
                       Text="Könyvek"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,10,0,10"/> 
            <DataGrid x:Name="BooksDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"/>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Text=""
                       FontWeight="Bold"
                       Margin="0,10,0,0"/>
        </Grid>


    </Grid>
</Window>
